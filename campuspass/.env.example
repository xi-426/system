# Copy this file to .env before starting Docker Compose.
# Values below are public local-demo placeholders. Replace them for deployment.
MYSQL_DATABASE=campuspass
MYSQL_USER=campuspass
MYSQL_PASSWORD=change-me-local-password
MYSQL_ROOT_PASSWORD=change-me-root-password

RABBITMQ_USERNAME=campuspass
RABBITMQ_PASSWORD=change-me-local-password

# Use a random secret of at least 32 characters outside local development.
JWT_SECRET=change-this-development-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=120
